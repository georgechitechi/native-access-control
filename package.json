{
  "name": "native-access-control",
  "version": "1.1.0",
  "description": "Zero-overhead, type-safe Role & Attribute-Based Access Control (RBAC/ABAC) for React, React Native, Node.js, and TypeScript.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "tsc && node --no-warnings --test tests/index.test.ts",
    "prepublishOnly": "npm run test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
